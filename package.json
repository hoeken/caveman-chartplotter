{
  "name": "caveman-chartplotter",
  "version": "1.3.0",
  "description": "Ooga booga! Me want simple chart plotter show custom charts on B&G.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "release": "git tag -d v$npm_package_version; git tag v$npm_package_version && git push && git push origin v$npm_package_version",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "eslint --fix . && prettier --write .",
    "format:check": "eslint . && prettier --check .",
    "prepare": "husky || true",
    "generate:icons": "node scripts/generate-icons.js",
    "build:ui": "vite build",
    "prepack": "npm run build:ui",
    "prepublishOnly": "npm test"
  },
  "files": [
    "src",
    "public",
    "docs/screenshots",
    "CHANGELOG.md"
  ],
  "lint-staged": {
    "*.js": "eslint --fix",
    "*.{json,css,html}": "prettier --write"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-chart-plotters"
  ],
  "signalk": {
    "appIcon": "logo.png",
    "displayName": "Caveman Chartplotter",
    "screenshots": [
      "./docs/screenshots/following.png",
      "./docs/screenshots/vessel.png",
      "./docs/screenshots/config.png"
    ],
    "recommends": [
      "signalk-navico-embedder",
      "signalk-questdb"
    ]
  },
  "signalk-plugin-enabled-by-default": true,
  "author": {
    "name": "Zach Hoeken",
    "email": "hoeken@gmail.com"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@signalk/tracks-plugin": "^2.0.2",
    "@turf/turf": "^7.3.5",
    "mathjs": "^15.2.0",
    "simplify-js": "^1.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoeken/caveman-chartplotter.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.3",
    "sharp": "^0.35.2",
    "vite": "^8.0.13"
  }
}
